{
  "name": "ted-ui",
  "version": "0.1.0",
  "description": "Ted's design system components",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fedos2589/TedUI.git"
  },
  "sideEffects": [
    "**/*.scss",
    "**/*.css",
    "DatePicker/dayjsLocales.ts"
  ],
  "main": "./index.tsx",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
