    "lint:ci": "eslint .",
    "prettier-format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build -o storybook-static"
  },
  "peerDependencies": {
    "dayjs": "^1.11.13",
    "i18next": "^26.0.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-i18next": "^17.0.2"
  },
  "peerDependenciesMeta": {
    "dayjs": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@remixicon/react": "^4.6.0",
    "classnames": "^2.5.1",
